# Copy this file to .env. OpenAI embeddings are optional; without this key
# Neo4j full-text GraphRAG remains available.
OPENAI_API_KEY=replace-with-your-real-key
GIM_LLM_ENDPOINT=http://127.0.0.1:11434/api/chat
GIM_LLM_MODEL=qwen3:14b
GIM_LLM_TIMEOUT=300
# Scoring model can be any provider with a compatible chat/completions API.
# GIM_LLM_ENDPOINT=https://provider.example/v1/chat/completions
# GIM_LLM_API_KEY=replace-with-provider-key
# Local Ollama scoring: pull qwen3:14b in this project's isolated GPU container.
GIM_COORDINATOR_TOKEN=replace-with-a-long-random-local-secret
# start-scoring.ps1 uses its isolated local PostgreSQL by default.
# GIM_DATABASE_URL=postgresql://gim:gim-local-db-2026@127.0.0.1:15432/gim

# This project's isolated Neo4j container; keep defaults for local development.
GIM_NEO4J_URI=bolt://127.0.0.1:17687
GIM_NEO4J_USER=neo4j
GIM_NEO4J_PASSWORD=gim-local-graph-2026
