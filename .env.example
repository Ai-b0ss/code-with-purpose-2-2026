# Copy this file to .env. OpenAI embeddings are optional; without this key
# Neo4j full-text GraphRAG remains available.
OPENAI_API_KEY=
GIM_LLM_ENDPOINT=http://127.0.0.1:11434/api/chat
GIM_LLM_MODEL=qwen3:14b
GIM_LLM_API_KEY=
GIM_LLM_TIMEOUT=300
# To use DeepSeek, replace the three GIM_LLM_* values above:
# GIM_LLM_ENDPOINT=https://api.deepseek.com/chat/completions
# GIM_LLM_MODEL=deepseek-v4-flash
# GIM_LLM_API_KEY=your-deepseek-api-key
# To use OpenAI instead:
# GIM_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# GIM_LLM_MODEL=gpt-4.1-mini
# GIM_LLM_API_KEY=your-openai-api-key
# To use ReformBoss instead (the API key stays on the server):
# GIM_LLM_ENDPOINT=https://api.reformboss.com/v1/chat/completions
# GIM_LLM_MODEL=deepseek-v4.1-flash
# GIM_LLM_API_KEY=your-reformboss-api-key
# With a cloud configuration in .env, start-scoring.ps1 -Local runs Ollama
# for that launch without changing the saved key or cloud settings.
# Local Ollama scoring: pull qwen3:14b in this project's isolated GPU container.
GIM_COORDINATOR_TOKEN=replace-with-a-long-random-local-secret
GIM_AUTH_REQUIRED=1
GIM_EVALUATION_MODE=rag_llm
# start-scoring.ps1 uses its isolated local PostgreSQL by default.
# GIM_DATABASE_URL=postgresql://gim:gim-local-db-2026@127.0.0.1:15432/gim

# This project's isolated Neo4j container; keep defaults for local development.
GIM_NEO4J_URI=bolt://127.0.0.1:17687
GIM_NEO4J_USER=neo4j
GIM_NEO4J_PASSWORD=gim-local-graph-2026
