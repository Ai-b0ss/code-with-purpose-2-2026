CREATE CONSTRAINT gim_fact_id IF NOT EXISTS FOR (n:Fact) REQUIRE n.id IS UNIQUE;
CREATE FULLTEXT INDEX gim_fact_text IF NOT EXISTS FOR (n:Fact) ON EACH [n.title, n.text];
MATCH (n:Fact) REMOVE n.embedding;
MERGE (n:Fact {id: "program:gim"}) SET n += {id: "program:gim", title: "Волонтёрская программа ГИМ", text: "Пять направлений волонтёрской деятельности. Оценка анкеты и решение о приглашении хранятся раздельно.", source_id: "architecture", quote: "Решение о приглашении, наличие мест и фактическая активность после приёма хранятся отдельно.", version_id: "gim-graph-v2", source_path: "pdf_files/03_arch.pdf"}, n:Program;
MERGE (n:Fact {id: "role:organizational"}) SET n += {id: "role:organizational", roles: ["organizational"], title: "Организационное направление", text: "Помощь в организации культурно-массовых мероприятий.", source_id: "questionnaire", quote: "Организационное направление (помощь в организации культурно-массовых мероприятий)", version_id: "gim-graph-v2", source_path: "docs/volunteer-questionnaire.docx"}, n:Role;
MERGE (n:Fact {id: "role:project"}) SET n += {id: "role:project", roles: ["project"], title: "Проектное направление", text: "Разработка квестов и мастер-классов для культурно-массовых мероприятий.", source_id: "questionnaire", quote: "Проектное направление (разработка квестов/мастер-классов для культурно-массовых мероприятий)", version_id: "gim-graph-v2", source_path: "docs/volunteer-questionnaire.docx"}, n:Role;
MERGE (n:Fact {id: "role:collections"}) SET n += {id: "role:collections", roles: ["collections"], title: "Фондовое направление", text: "Уточнить интересующие фонды и наличие подходящих задач. Места ограничены; выбор только фондов сам по себе не снижает оценку.", source_id: "architecture", quote: "Указание только фондового направления не штрафуется", version_id: "gim-graph-v2", source_path: "pdf_files/03_arch.pdf"}, n:Role;
MERGE (n:Fact {id: "role:inclusive"}) SET n += {id: "role:inclusive", roles: ["inclusive"], title: "Инклюзивное направление", text: "Инклюзивное музейное волонтёрство. Конкретные задачи, подготовку и условия нужно согласовать с координатором; они не перечислены в исходной анкете.", source_id: "questionnaire", quote: "Инклюзивное направление", version_id: "gim-graph-v2", source_path: "docs/volunteer-questionnaire.docx"}, n:Role;
MERGE (n:Fact {id: "role:media"}) SET n += {id: "role:media", roles: ["media"], title: "Медиа-волонтёрство", text: "Контент-план, видеоформаты, фото, посты, разработка рубрик и дизайн.", source_id: "questionnaire", quote: "составление контент-плана, видеоформаты, фото, написание постов, разработка рубрик, дизайн", version_id: "gim-graph-v2", source_path: "docs/volunteer-questionnaire.docx"}, n:Role;
MERGE (n:Fact {id: "task:audience"}) SET n += {id: "task:audience", roles: ["organizational"], title: "Работа с аудиторией", text: "Уточнить предпочитаемую аудиторию: дети, молодёжь, взрослые или пенсионеры.", source_id: "questionnaire", quote: "С какой категорией посетителей предпочитаете работать: дети, молодежь, средний возраст, пенсионеры?", version_id: "gim-graph-v2", source_path: "docs/volunteer-questionnaire.docx"}, n:Task;
MERGE (n:Fact {id: "task:quest"}) SET n += {id: "task:quest", roles: ["project"], title: "Квесты и образовательные форматы", text: "Выбрать конкретный формат: мастер-класс, квест, экскурсия, образовательная игра.", source_id: "questionnaire", quote: "Какие форматы вам ближе: мастер-классы, квесты, экскурсии, образовательные игры?", version_id: "gim-graph-v2", source_path: "docs/volunteer-questionnaire.docx"}, n:Task;
MERGE (n:Fact {id: "task:funds"}) SET n += {id: "task:funds", roles: ["collections"], title: "Интересующие фонды", text: "Кандидат называет интересующие фонды и задачи. Наличие вакансии проверяется отдельно от качества анкеты.", source_id: "questionnaire", quote: "Какие фонды вас привлекают для работы?", version_id: "gim-graph-v2", source_path: "docs/volunteer-questionnaire.docx"}, n:Task;
MERGE (n:Fact {id: "task:inclusive"}) SET n += {id: "task:inclusive", roles: ["inclusive"], title: "Применимые навыки в инклюзии", text: "Учитывать конкретный опыт и переносимые навыки; не обещать задачи, которых нет в материалах программы.", source_id: "questionnaire", quote: "Профильный опыт: работа в фондах, инклюзии, на выставках", version_id: "gim-graph-v2", source_path: "docs/volunteer-questionnaire.docx"}, n:Task;
MERGE (n:Fact {id: "task:photo"}) SET n += {id: "task:photo", roles: ["media"], title: "Фото и видео", text: "Уточнить интерес к фото или видео и конкретные действия, которые кандидат умеет выполнять.", source_id: "questionnaire", quote: "видеоформаты, фото", version_id: "gim-graph-v2", source_path: "docs/volunteer-questionnaire.docx"}, n:Task;
MERGE (n:Fact {id: "task:content"}) SET n += {id: "task:content", roles: ["media"], title: "Тексты, рубрики и дизайн", text: "Подготовка контента: посты, рубрики, контент-план и дизайн.", source_id: "questionnaire", quote: "написание постов, разработка рубрик, дизайн", version_id: "gim-graph-v2", source_path: "docs/volunteer-questionnaire.docx"}, n:Task;
MERGE (n:Fact {id: "skill:transferable"}) SET n += {id: "skill:transferable", title: "Переносимые навыки", text: "Отсутствие формального музейного стажа не равно низкой оценке. Применимый навык можно подтвердить примером или коротким кейсом.", source_id: "audit", quote: "Пустой ответ или отсутствие формального стажа не равны q=0.", version_id: "gim-graph-v2", source_path: "pdf_files/01_audit.pdf"}, n:Skill;
MERGE (n:Fact {id: "skill:communication"}) SET n += {id: "skill:communication", title: "Коммуникация и совместная работа", text: "Использовать конкретный пример взаимодействия и выполнения обязательств, не выводить черты личности из стиля письма.", source_id: "audit", quote: "не выводить черты личности из стиля письма", version_id: "gim-graph-v2", source_path: "pdf_files/01_audit.pdf"}, n:Skill;
MERGE (n:Fact {id: "condition:availability"}) SET n += {id: "condition:availability", title: "Фактическая доступность", text: "Оценивать часы, дни и формат относительно документированных требований выбранной роли. В текущих источниках нет единого обязательного минимума часов и подтверждённого расписания всех ролей; нельзя выдумывать эти условия.", source_id: "architecture", quote: "Проверить против требований выбранной роли.", version_id: "gim-graph-v2", source_path: "pdf_files/03_arch.pdf"}, n:Condition;
MERGE (n:Fact {id: "condition:alternatives"}) SET n += {id: "condition:alternatives", roles: ["collections"], title: "Предпочтение фондов и альтернативы", text: "Спросить об альтернативах, но не штрафовать автоматически за предпочтение только фондов. Ограниченность мест хранится отдельно.", source_id: "architecture", quote: "Указание только фондового направления не штрафуется", version_id: "gim-graph-v2", source_path: "pdf_files/03_arch.pdf"}, n:Condition;
MERGE (n:Fact {id: "condition:privacy"}) SET n += {id: "condition:privacy", title: "Контакты вне LLM", text: "ФИО, почта, VK, дата рождения и согласие находятся в отдельном хранилище и не передаются модели.", source_id: "architecture", quote: "Контакты не проходят через LLM", version_id: "gim-graph-v2", source_path: "pdf_files/03_arch.pdf"}, n:Condition;
MERGE (n:Fact {id: "condition:no-proxies"}) SET n += {id: "condition:no-proxies", title: "Нет автоматических социальных штрафов", text: "Вуз, курс, возраст, источник знакомства с программой, открытость VK и объём текста не дают автоматических баллов или штрафов.", source_id: "audit", quote: "Название вуза, курс, возраст, источник знакомства с программой, открытость ВК и объём текста не дают автоматических бонусов или штрафов.", version_id: "gim-graph-v2", source_path: "pdf_files/01_audit.pdf"}, n:Condition;
MERGE (n:Fact {id: "criterion:motivation"}) SET n += {id: "criterion:motivation", title: "Мотивация · 25%", text: "1 — нет связи с задачей после уточнения; 2 — частичная конкретика; 3 — конкретная цель и вклад.", source_id: "architecture", quote: "конкретная цель и вклад.", version_id: "gim-graph-v2", source_path: "pdf_files/03_arch.pdf"}, n:Criterion;
MERGE (n:Fact {id: "criterion:role_fit"}) SET n += {id: "criterion:role_fit", title: "Соответствие роли · 20%", text: "1 — нет подходящих задач; 2 — частичное соответствие; 3 — выбраны реалистичные задачи.", source_id: "architecture", quote: "выбраны реалистичные задачи.", version_id: "gim-graph-v2", source_path: "pdf_files/03_arch.pdf"}, n:Criterion;
MERGE (n:Fact {id: "criterion:skills"}) SET n += {id: "criterion:skills", title: "Навыки и опыт · 20%", text: "1 — нет применимого навыка после кейса; 2 — переносимый навык; 3 — навык с конкретным примером.", source_id: "architecture", quote: "навык с конкретным примером.", version_id: "gim-graph-v2", source_path: "pdf_files/03_arch.pdf"}, n:Criterion;
MERGE (n:Fact {id: "criterion:availability"}) SET n += {id: "criterion:availability", title: "Доступность · 15%", text: "1 — явно не выполняет обязательный график; 2 — подтверждён подходящий ограниченный формат; 3 — соответствует графику роли. Если обязательные условия не заданы или совместимость неясна, оставить null.", source_id: "architecture", quote: "подходящий ограниченный формат", version_id: "gim-graph-v2", source_path: "pdf_files/03_arch.pdf"}, n:Criterion;
MERGE (n:Fact {id: "criterion:task_understanding"}) SET n += {id: "criterion:task_understanding", title: "Понимание задач · 10%", text: "1 — неверное ожидание без готовности уточнить; 2 — частичное понимание; 3 — реалистичное понимание.", source_id: "architecture", quote: "реалистичное понимание.", version_id: "gim-graph-v2", source_path: "pdf_files/03_arch.pdf"}, n:Criterion;
MERGE (n:Fact {id: "criterion:responsibility"}) SET n += {id: "criterion:responsibility", title: "Ответственность · 10%", text: "1 — игнорирует обязательства; 2 — частичное решение кейса; 3 — предупреждает и согласует решение.", source_id: "architecture", quote: "предупреждает и согласует решение.", version_id: "gim-graph-v2", source_path: "pdf_files/03_arch.pdf"}, n:Criterion;
MERGE (n:Fact {id: "faq:responsibility"}) SET n += {id: "faq:responsibility", title: "Кейс о согласованной смене", text: "Кандидат описывает, что предпримет, если не успевает на согласованную смену или задачу. Отсутствие ответа не заменяется оценкой 1.", source_id: "architecture", quote: "как поступит, если не успевает на согласованную смену/задачу.", version_id: "gim-graph-v2", source_path: "pdf_files/03_arch.pdf"}, n:Faq;
MERGE (n:Fact {id: "faq:missing"}) SET n += {id: "faq:missing", title: "Недостающие ответы", text: "Не более двух уточнений на обязательный пропуск. Если данных недостаточно, оценка критерия и итоговый балл остаются null; веса не перераспределяются.", source_id: "architecture", quote: "веса не перераспределяются.", version_id: "gim-graph-v2", source_path: "pdf_files/03_arch.pdf"}, n:Faq;
MERGE (n:Fact {id: "faq:historical-zero"}) SET n += {id: "faq:historical-zero", title: "Исторические нули", text: "Исторический ноль — статус «не пригласили», а не оценка 1 по новой шкале. Решение о приёме и активность не используются как признаки кандидата.", source_id: "architecture", quote: "Исторические нули не преобразуются в единицы.", version_id: "gim-graph-v2", source_path: "pdf_files/03_arch.pdf"}, n:Faq;
MERGE (n:Fact {id: "faq:rounding"}) SET n += {id: "faq:rounding", title: "Расчёт результата", text: "Модель выдаёт шесть целых оценок 1–3 либо null. Сервер считает N=Σ(p_i*r_i), затем score=((2*N+25)//50)/4. Итог 1–3 с шагом 0,25.", source_id: "architecture", quote: "k = (2 × N + 25) // 50", version_id: "gim-graph-v2", source_path: "pdf_files/03_arch.pdf"}, n:Faq;
MERGE (n:Fact {id: "faq:precedence"}) SET n += {id: "faq:precedence", title: "Приоритет исправленной архитектуры", text: "Для расчёта используется исправленная шестикритериальная рубрика из 03_arch.pdf. Старые пять групп и социальные прокси в анкете не становятся отдельными весами или автоматическими штрафами.", source_id: "architecture", quote: "обязательны все шесть criterion_id ровно по одному", version_id: "gim-graph-v2", source_path: "pdf_files/03_arch.pdf"}, n:Faq;
MATCH (a:Fact {id: "program:gim"}), (b:Fact {id: "role:organizational"}) MERGE (a)-[:HAS_ROLE]->(b);
MATCH (a:Fact {id: "program:gim"}), (b:Fact {id: "role:project"}) MERGE (a)-[:HAS_ROLE]->(b);
MATCH (a:Fact {id: "program:gim"}), (b:Fact {id: "role:collections"}) MERGE (a)-[:HAS_ROLE]->(b);
MATCH (a:Fact {id: "program:gim"}), (b:Fact {id: "role:inclusive"}) MERGE (a)-[:HAS_ROLE]->(b);
MATCH (a:Fact {id: "program:gim"}), (b:Fact {id: "role:media"}) MERGE (a)-[:HAS_ROLE]->(b);
MATCH (a:Fact {id: "role:organizational"}), (b:Fact {id: "task:audience"}) MERGE (a)-[:HAS_TASK]->(b);
MATCH (a:Fact {id: "role:project"}), (b:Fact {id: "task:quest"}) MERGE (a)-[:HAS_TASK]->(b);
MATCH (a:Fact {id: "role:collections"}), (b:Fact {id: "task:funds"}) MERGE (a)-[:HAS_TASK]->(b);
MATCH (a:Fact {id: "role:inclusive"}), (b:Fact {id: "task:inclusive"}) MERGE (a)-[:HAS_TASK]->(b);
MATCH (a:Fact {id: "role:media"}), (b:Fact {id: "task:photo"}) MERGE (a)-[:HAS_TASK]->(b);
MATCH (a:Fact {id: "role:media"}), (b:Fact {id: "task:content"}) MERGE (a)-[:HAS_TASK]->(b);
MATCH (a:Fact {id: "role:organizational"}), (b:Fact {id: "condition:availability"}) MERGE (a)-[:REQUIRES]->(b);
MATCH (a:Fact {id: "role:project"}), (b:Fact {id: "condition:availability"}) MERGE (a)-[:REQUIRES]->(b);
MATCH (a:Fact {id: "role:collections"}), (b:Fact {id: "condition:availability"}) MERGE (a)-[:REQUIRES]->(b);
MATCH (a:Fact {id: "role:inclusive"}), (b:Fact {id: "condition:availability"}) MERGE (a)-[:REQUIRES]->(b);
MATCH (a:Fact {id: "role:media"}), (b:Fact {id: "condition:availability"}) MERGE (a)-[:REQUIRES]->(b);
MATCH (a:Fact {id: "role:collections"}), (b:Fact {id: "condition:alternatives"}) MERGE (a)-[:CLARIFIED_BY]->(b);
MATCH (a:Fact {id: "task:audience"}), (b:Fact {id: "skill:communication"}) MERGE (a)-[:USES_SKILL]->(b);
MATCH (a:Fact {id: "task:quest"}), (b:Fact {id: "skill:transferable"}) MERGE (a)-[:USES_SKILL]->(b);
MATCH (a:Fact {id: "task:funds"}), (b:Fact {id: "skill:transferable"}) MERGE (a)-[:USES_SKILL]->(b);
MATCH (a:Fact {id: "task:inclusive"}), (b:Fact {id: "skill:communication"}) MERGE (a)-[:USES_SKILL]->(b);
MATCH (a:Fact {id: "task:photo"}), (b:Fact {id: "skill:transferable"}) MERGE (a)-[:USES_SKILL]->(b);
MATCH (a:Fact {id: "task:content"}), (b:Fact {id: "skill:transferable"}) MERGE (a)-[:USES_SKILL]->(b);
MATCH (a:Fact {id: "task:audience"}), (b:Fact {id: "criterion:role_fit"}) MERGE (a)-[:ASSESSED_BY]->(b);
MATCH (a:Fact {id: "task:quest"}), (b:Fact {id: "criterion:role_fit"}) MERGE (a)-[:ASSESSED_BY]->(b);
MATCH (a:Fact {id: "task:funds"}), (b:Fact {id: "criterion:role_fit"}) MERGE (a)-[:ASSESSED_BY]->(b);
MATCH (a:Fact {id: "task:inclusive"}), (b:Fact {id: "criterion:role_fit"}) MERGE (a)-[:ASSESSED_BY]->(b);
MATCH (a:Fact {id: "task:photo"}), (b:Fact {id: "criterion:role_fit"}) MERGE (a)-[:ASSESSED_BY]->(b);
MATCH (a:Fact {id: "task:content"}), (b:Fact {id: "criterion:role_fit"}) MERGE (a)-[:ASSESSED_BY]->(b);
MATCH (a:Fact {id: "skill:transferable"}), (b:Fact {id: "criterion:skills"}) MERGE (a)-[:ASSESSED_BY]->(b);
MATCH (a:Fact {id: "skill:communication"}), (b:Fact {id: "criterion:skills"}) MERGE (a)-[:ASSESSED_BY]->(b);
MATCH (a:Fact {id: "condition:availability"}), (b:Fact {id: "criterion:availability"}) MERGE (a)-[:ASSESSED_BY]->(b);
MATCH (a:Fact {id: "program:gim"}), (b:Fact {id: "condition:privacy"}) MERGE (a)-[:GOVERNED_BY]->(b);
MATCH (a:Fact {id: "program:gim"}), (b:Fact {id: "condition:no-proxies"}) MERGE (a)-[:GOVERNED_BY]->(b);
MATCH (a:Fact {id: "program:gim"}), (b:Fact {id: "faq:responsibility"}) MERGE (a)-[:HAS_FAQ]->(b);
MATCH (a:Fact {id: "program:gim"}), (b:Fact {id: "faq:missing"}) MERGE (a)-[:HAS_FAQ]->(b);
MATCH (a:Fact {id: "program:gim"}), (b:Fact {id: "faq:historical-zero"}) MERGE (a)-[:HAS_FAQ]->(b);
MATCH (a:Fact {id: "program:gim"}), (b:Fact {id: "faq:rounding"}) MERGE (a)-[:HAS_FAQ]->(b);
MATCH (a:Fact {id: "program:gim"}), (b:Fact {id: "faq:precedence"}) MERGE (a)-[:HAS_FAQ]->(b);
MATCH (a:Fact {id: "faq:responsibility"}), (b:Fact {id: "criterion:responsibility"}) MERGE (a)-[:ASSESSED_BY]->(b);
MATCH (a:Fact {id: "faq:precedence"}), (b:Fact {id: "criterion:motivation"}) MERGE (a)-[:APPLIES_TO]->(b);
MATCH (a:Fact {id: "faq:precedence"}), (b:Fact {id: "criterion:task_understanding"}) MERGE (a)-[:APPLIES_TO]->(b);
